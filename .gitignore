# ---- Local staging folders (GSIs, firmware, tools) ----
/gsi/
/gsi-aosp16/
/firmware/
/platform-tools/
build.prop

# ---- Device-unique data and diagnostic dumps (IMEI, serials, ICCID) ----
/dumps/
*.qcn
*.xqcn
/persist*
/modemst*
/fsg*
/efs*
getvar*.txt
logcat*.txt
dmesg*.txt
bugreport*
