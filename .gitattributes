* text=auto

# Linux-side files must be LF or bash/python in WSL choke on $'\r'
*.sh    text eol=lf
*.py    text eol=lf
*.bp    text eol=lf
*.mk    text eol=lf
*.xml   text eol=lf
*.patch text eol=lf
*.diff  text eol=lf

# Windows PowerShell
*.ps1   text eol=crlf

*.img binary
*.apk binary
*.7z  binary
*.zip binary

# Patches against files that themselves contain CRLF line endings must be kept byte-exact
patches/kernel/motorola/sm6475-modules/motorola/*.patch -text
